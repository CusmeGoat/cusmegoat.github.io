---
import OwlMark from './OwlMark.astro';
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="#inicio" aria-label="José Carlos Cusme, ir al inicio">
      <span class="brand-mark"><OwlMark /></span>
      <span class="brand-name">José Carlos Cusme</span>
    </a>
    <nav class="desktop-nav" aria-label="Navegación principal">
      <a href="#perfil">Perfil</a>
      <a href="#experiencia">Experiencia</a>
      <a href="#capacidades">Habilidades</a>
      <a href="#proyectos">Proyectos</a>
      <a href="#formacion">Formación</a>
      <a class="nav-contact" href="#contacto">Hablemos <span aria-hidden="true">↗</span></a>
    </nav>
    <button class="theme-toggle" type="button" data-theme-toggle aria-label="Activar tema claro" title="Activar tema claro">
      <span class="theme-icon theme-icon-sun" aria-hidden="true">☼</span>
      <span class="theme-icon theme-icon-moon" aria-hidden="true">☾</span>
    </button>
    <details class="mobile-nav">
      <summary aria-label="Abrir menú"><span></span><span></span><span></span></summary>
      <nav aria-label="Navegación móvil">
        <a href="#perfil">Perfil</a>
        <a href="#experiencia">Experiencia</a>
        <a href="#capacidades">Habilidades</a>
        <a href="#proyectos">Proyectos</a>
        <a href="#formacion">Formación</a>
        <a href="#contacto">Contacto</a>
      </nav>
    </details>
  </div>
</header>
