---
interface Props {
  number: string;
  eyebrow: string;
  title: string;
  description?: string;
}

const { number, eyebrow, title, description } = Astro.props;
---

<div class="section-intro" data-reveal>
  <div class="section-label"><span>{number}</span><span>{eyebrow}</span></div>
  <h2>{title}</h2>
  {description && <p>{description}</p>}
</div>
