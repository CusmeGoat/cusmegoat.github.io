---
import { profile } from '../data/profile';
import OwlMark from './OwlMark.astro';
---

<section id="inicio" class="hero">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="container hero-grid">
    <div class="hero-copy" data-reveal>
      <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> Ingeniero en Sistemas de Información</p>
      <h1>Construyo soluciones <em>de extremo a extremo.</em></h1>
      <p class="hero-description">{profile.introduction}</p>
      <div class="hero-actions">
        <a class="button button-primary" href="#proyectos">Ver proyectos <span aria-hidden="true">↗</span></a>
        <a class="button button-secondary" href={profile.cv} download>Descargar CV <span aria-hidden="true">↓</span></a>
      </div>
      <div class="hero-meta">
        <span>{profile.location}</span>
        <span>Full Stack <span class="meta-star" aria-hidden="true">✳</span> DevOps</span>
      </div>
    </div>

    <div class="hero-visual" data-reveal>
      <div class="portrait-frame">
        <img src="/jose-carlos-cusme.png" alt="Retrato de José Carlos Cusme Montenegro" width="533" height="800" fetchpriority="high" decoding="async" />
        <div class="portrait-shine" aria-hidden="true"></div>
        <div class="portrait-identity">
          <span>JOSÉ CARLOS CUSME</span>
          <strong>Full Stack <span aria-hidden="true">✦</span> DevOps</strong>
        </div>
      </div>
      <div class="portrait-stamp" aria-hidden="true"><OwlMark /></div>
      <div class="portrait-coordinate" aria-hidden="true">EC / 02°11′ S</div>
    </div>
  </div>
  <div class="hero-bottom"><span>Desliza para conocer mi trabajo</span><span aria-hidden="true">↓</span></div>
</section>
