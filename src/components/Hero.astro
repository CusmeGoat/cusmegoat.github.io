---
import { profile } from '../data/profile';
---

<section id="inicio" class="hero">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="container hero-grid">
    <div class="hero-copy" data-reveal>
      <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> Ingeniero en Sistemas de Información</p>
      <h1>Construyo soluciones <em>de extremo a extremo.</em></h1>
      <p class="hero-description">{profile.introduction}</p>
      <div class="hero-actions">
        <a class="button button-primary" href="#experiencia">Explorar mi experiencia <span aria-hidden="true">↗</span></a>
        <a class="button button-secondary" href={profile.cv} download>Descargar CV <span aria-hidden="true">↓</span></a>
      </div>
      <div class="hero-meta">
        <span>{profile.location}</span>
        <span>Full Stack <span class="meta-star" aria-hidden="true">✳</span> DevOps</span>
      </div>
    </div>

    <div class="hero-visual" data-reveal aria-label="Áreas de trabajo: interfaz, servicios, datos y entrega">
      <div class="visual-topline">
        <span class="visual-indicator"><span></span><span></span><span></span></span>
        <span>MAPA DE TRABAJO</span>
        <span>01 / 04</span>
      </div>
      <div class="visual-core">
        <div class="core-orbit orbit-one"></div>
        <div class="core-orbit orbit-two"></div>
        <div class="core-center"><span>FULL</span><strong>STACK</strong><span>+ DEVOPS</span></div>
        <span class="orbit-spark spark-one"></span>
        <span class="orbit-spark spark-two"></span>
      </div>
      <ol class="visual-flow">
        <li><span>01</span><strong>Interfaz</strong><small>Angular</small></li>
        <li><span>02</span><strong>Servicios</strong><small>Spring Boot</small></li>
        <li><span>03</span><strong>Datos</strong><small>Oracle · MongoDB</small></li>
        <li><span>04</span><strong>Entrega</strong><small>Jenkins · OpenShift</small></li>
      </ol>
      <div class="visual-bottomline"><span>CONSTRUIR</span><span>INTEGRAR</span><span>DESPLEGAR</span></div>
    </div>
  </div>
  <div class="hero-bottom"><span>Desliza para conocer mi trabajo</span><span aria-hidden="true">↓</span></div>
</section>
